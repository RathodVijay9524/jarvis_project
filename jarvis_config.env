# JARVIS AI Assistant Configuration
# Rename this file to .env to activate

# ===== AI PROVIDERS =====
# Groq API (Primary AI provider for JARVIS)
GROQ_API_KEY=

# ===== JARVIS CONFIGURATION =====
# Default voice for text-to-speech
JARVIS_VOICE=tony

# Default AI model
JARVIS_AI_MODEL=groq

# Voice activation settings
JARVIS_WAKE_WORD=jarvis
JARVIS_VOICE_TIMEOUT=8
